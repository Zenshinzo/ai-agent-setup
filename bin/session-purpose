#!/usr/bin/env python3
# session-purpose — one line saying what a tmux/Claude session is FOR, kept with the session-snap
# snapshot so `session-purpose --list` answers "what are all my sessions?" and restore can show it.
# Python 3.9-compatible on purpose (older macOS ships python3 3.9).
#
#   session-purpose                       show this session's purpose
#   session-purpose "text"                set it yourself (always wins)
#   session-purpose --by-claude "text"    set it as the Claude inside the session (never overrides yours)
#   session-purpose -s NAME [...]         another session on this host
#   session-purpose --list [--closed]     every live session (+ closed ones) with its purpose
#
# Precedence: manual > claude > first-prompt (the first thing typed, filled in by session-snap).
import argparse, fcntl, json, os, shutil, subprocess, sys, time

STATE = os.environ.get("SESSION_STATE_DIR") or os.path.expanduser("~/.local/state/agent-sessions")
LATEST = os.path.join(STATE, "latest.json")
PURPOSES = os.path.join(STATE, "purposes.json")
HERE = os.path.dirname(os.path.realpath(__file__))


def tmux_bin():
    for p in (shutil.which("tmux"), "/opt/homebrew/bin/tmux", "/usr/local/bin/tmux", "/usr/bin/tmux"):
        if p and os.path.exists(p):
            return [p, "-L", os.environ["SESSION_TMUX_L"]] if os.environ.get("SESSION_TMUX_L") else [p]
    sys.exit("tmux not found")


def snap():
    exe = os.path.join(HERE, "session-snap")
    subprocess.run([exe if os.path.exists(exe) else "session-snap"], check=False)
    return json.load(open(LATEST))


def current_session():
    pane = os.environ.get("TMUX_PANE")
    if not pane:
        sys.exit("not inside tmux — name the session with -s NAME")
    out = subprocess.run(tmux_bin() + ["display-message", "-p", "-t", pane, "#S"],
                         capture_output=True, text=True).stdout.strip()
    return out or sys.exit("can't tell which tmux session this is — use -s NAME")


def ago(ts):
    d = int(time.time() - ts)
    for n, u in ((86400, "d"), (3600, "h"), (60, "m")):
        if d >= n:
            return "%d%s ago" % (d // n, u)
    return "just now"


def show_list(data, closed):
    rows = [(s, None) for s in data.get("sessions", []) if not s.get("starter")]
    if closed:
        rows += [(c, c.get("closed_at")) for c in data.get("closed", [])]
    print("%s — %d live%s" % (data.get("htag"), sum(1 for _, c in rows if c is None),
                             (", %d closed (restorable)" % sum(1 for _, c in rows if c)) if closed else ""))
    for s, closed_at in rows:
        p = s.get("purpose") or {}
        tag = ("closed " + ago(closed_at)) if closed_at else ""
        src = {"first-prompt": " (first prompt)"}.get(p.get("source"), "")
        print("  %-24s %-14s %s%s" % (s["name"][:24], tag, (p.get("text") or "— no purpose recorded —")[:100], src))


def main():
    ap = argparse.ArgumentParser(description="what each session is for")
    ap.add_argument("text", nargs="*")
    ap.add_argument("-s", "--session")
    ap.add_argument("--by-claude", action="store_true")
    ap.add_argument("--list", action="store_true")
    ap.add_argument("--closed", action="store_true", help="with --list: include closed sessions")
    a = ap.parse_args()

    data = snap()
    if a.list:
        return show_list(data, a.closed)
    name = a.session or current_session()
    s = next((x for x in data.get("sessions", []) if x["name"] == name), None)
    if not s:
        sys.exit("no live session called %r on this host" % name)
    if not a.text:
        p = s.get("purpose") or {}
        print("%s: %s  [%s]" % (name, p.get("text") or "— none —", p.get("source") or "-"))
        return
    text = " ".join(" ".join(a.text).split())[:200]
    source = "claude" if a.by_claude else "manual"
    uuid = s.get("uuid") or (s.get("last") or {}).get("uuid")
    with open(os.path.join(STATE, ".lock"), "w") as lk:
        fcntl.flock(lk, fcntl.LOCK_EX)
        try:
            pur = json.load(open(PURPOSES))
        except Exception:
            pur = {}
        keys = [("by_name", name)] + ([("by_uuid", uuid)] if uuid else [])
        if source == "claude":
            for t, k in keys:
                e = (pur.get(t) or {}).get(k)
                if e and e.get("source") == "manual":
                    print("kept your purpose (a Claude never overrides it): " + e["text"])
                    return
        entry = {"text": text, "source": source, "set_at": int(time.time())}
        for t, k in keys:
            pur.setdefault(t, {})[k] = entry
        tmp = PURPOSES + ".tmp"
        with open(tmp, "w") as fh:
            json.dump(pur, fh, indent=1)
        os.replace(tmp, PURPOSES)
    snap()                                            # so latest.json carries it now
    print("%s: %s  [%s]" % (name, text, source))


if __name__ == "__main__":
    main()
